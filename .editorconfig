root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = intellij_idea
max_line_length = 120
# Backtick test names such as `creates strings xml for every locale` are idiomatic in JUnit tests.
ktlint_function_naming_ignore_when_annotated_with = Test

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
